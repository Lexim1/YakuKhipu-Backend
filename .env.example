# Copiar como backend/.env y completar. NO subir .env (está en .gitignore).

# PostgreSQL creado manualmente con sql/yakukhipu_final.sql.
DATABASE_URL=postgresql+psycopg://yakukhipu:clave@localhost:5432/yakukhipu_final

FRONTEND_ORIGIN=http://localhost:5173
# Clave para firmar la cookie de sesión. Generar una propia: python -c "import secrets;print(secrets.token_urlsafe(32))"
SECRET_KEY=colocar_solo_en_env_local
# true cuando se publica detrás de HTTPS.
COOKIE_SECURE=false
# Configuración de producción OIDC. Configura valores secretos en Railway.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
PORTAL_ORIGIN=
# Bucket privado para ingreso y consulta del PDF.
PDF_BUCKET=
PDF_ENDPOINT=
PDF_REGION=auto
PDF_ACCESS_KEY=
PDF_SECRET_KEY=
PDF_ADDRESSING_STYLE=virtual
# «Hoy» para la demo (los plazos se ven igual que en el prototipo). Vacío = fecha real.
FECHA_DEMO=
# Carpeta local con los PDF de los casos (no se sube). Permite abrir el PDF de una cita.
DOCUMENTOS_DIR=

# Asistente: API compatible con OpenAI. Opción A, OpenRouter directo:
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=openrouter/free
# Opción B, OmniRoute local:  LLM_BASE_URL=http://localhost:20128/v1  y  LLM_MODEL=<combo del panel>
# false: el portal funciona y el asistente responde 503 «no disponible».
LLM_ENABLED=false
CACHE_ACTIVA=true
CACHE_HORAS=24
